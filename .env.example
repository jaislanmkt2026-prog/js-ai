# Configuração do Servidor
PORT=4000
NODE_ENV=production

# Fornecedor Oficial de APIs (Nimo Shop / Telegram Bot)
NIMO_BUYER_KEY=sua_chave_nimo_shop_aqui
NIMO_API_BASE=https://canboso.com

# Gateway de Pagamento Pix
PIX_GATEWAY=mercadopago
MERCADOPAGO_ACCESS_TOKEN=seu_token_mercadopago_aqui

# Senha de Segurança do Painel Administrativo (/admin)
ADMIN_TOKEN=defina_uma_senha_forte_aqui
